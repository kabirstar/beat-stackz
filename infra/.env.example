# copy to repo root as .env
DATABASE_URL=postgres://bpackz:bpackz@localhost:5432/bpackz

S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=bpackz
S3_ACCESS_KEY=bpackz
S3_SECRET_KEY=bpackz-secret
S3_FORCE_PATH_STYLE=true
# Optional. Where BROWSERS reach the bucket when it differs from where the API reaches it
# (compose: API uses http://rustfs:9000, browsers use http://localhost:9000). Unset = same as S3_ENDPOINT.
# S3_PUBLIC_ENDPOINT=http://localhost:9000

BETTER_AUTH_SECRET=change-me-32-chars-minimum-random-string
BETTER_AUTH_URL=http://localhost:4000

WEB_ORIGIN=http://localhost:5173
API_ORIGIN=http://localhost:4000

BACKUP_BUCKET=bpackz-backups           # second bucket for nightly pg_dump (T043)
# BACKUP_INTERVAL=86400

# ---- hosted (see docs/HOSTING.md) ----
# NODE_ENV=production
# POSTGRES_PASSWORD=long-random-value          # used by infra/docker-compose.prod.yml
# S3_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
# S3_REGION=auto
# BETTER_AUTH_URL=https://api.example.com
# API_ORIGIN=https://api.example.com
# WEB_ORIGIN=https://app.example.com
