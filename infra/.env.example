# copy to repo root as .env
DATABASE_URL=postgres://bpackz:bpackz@localhost:5432/bpackz

S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=bpackz
S3_ACCESS_KEY=bpackz
S3_SECRET_KEY=bpackz-secret
S3_FORCE_PATH_STYLE=true
# Optional. Where BROWSERS reach the bucket when it differs from where the API reaches it
# (compose: API uses http://rustfs:9000, browsers use http://localhost:9000). Unset = same as S3_ENDPOINT.
# S3_PUBLIC_ENDPOINT=http://localhost:9000

BETTER_AUTH_SECRET=change-me-32-chars-minimum-random-string
BETTER_AUTH_URL=http://localhost:4000

WEB_ORIGIN=http://localhost:5173
API_ORIGIN=http://localhost:4000
