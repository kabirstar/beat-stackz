{
  "name": "bpackz",
  "private": true,
  "packageManager": "pnpm@10.34.7",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "typecheck": "pnpm -r --if-present run typecheck",
    "lint": "oxlint .",
    "test": "pnpm -r --if-present run test",
    "openapi": "pnpm -F @bpackz/shared openapi",
    "gate:fast": "pnpm typecheck && pnpm lint && gitleaks protect --staged --redact",
    "ledger": "node infra/pr-ledger.mjs"
  },
  "devDependencies": {
    "oxlint": "^1.89.0",
    "turbo": "^2.5.0",
    "typescript": "^5.9.0"
  }
}
