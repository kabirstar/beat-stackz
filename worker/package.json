{
  "name": "worker",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": { "node": ">=24" },
  "scripts": {
    "dev": "node --env-file-if-exists=../.env src/index.ts",
    "start": "node --env-file-if-exists=../.env src/index.ts",
    "typecheck": "tsc --noEmit",
    "test": "node --env-file-if-exists=../.env --test --test-concurrency=1 test/*.test.ts",
    "test:cov": "node --env-file-if-exists=../.env --test --test-concurrency=1 --experimental-test-coverage --test-coverage-exclude=test/** --test-reporter=spec --test-reporter-destination=stdout --test-reporter=lcov --test-reporter-destination=coverage/lcov.info test/*.test.ts"
  },
  "dependencies": {
    "@bpackz/shared": "workspace:*",
    "api": "workspace:*",
    "@aws-sdk/client-s3": "^3.1155.0",
    "drizzle-orm": "0.45.4"
  },
  "devDependencies": {
    "@hono/node-server": "^2.1.5",
    "@types/node": "^24.19.2",
    "typescript": "~5.9.3"
  }
}
