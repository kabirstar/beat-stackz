{
  "name": "api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "packageManager": "pnpm@10.34.7",
  "scripts": {
    "dev": "node --watch src/server.ts",
    "build": "tsc -p tsconfig.json",
