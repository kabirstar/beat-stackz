{
  "threshold": 3,
  "minTokens": 50,
  "minLines": 5,
  "format": [
    "typescript",
    "tsx",
    "javascript"
  ],
  "ignore": [
    "**/node_modules/**",
    "**/dist/**",
    "**/coverage/**",
    "**/*.test.*",
    "**/test/**",
    "contracts/**",
    "**/*.json",
    "**/*.md",
    "red-checkout/**",
    "brain/logs/**",
    "**/.turbo/**"
  ],
  "reporters": [
    "console"
  ],
  "gitignore": true
}
